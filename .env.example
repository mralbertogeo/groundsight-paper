# Copie para .env e ajuste. NUNCA commitar o .env.
POSTGRES_USER=fav
POSTGRES_PASSWORD=trocar_esta_senha
POSTGRES_DB=favorabilidade
DATABASE_URL=postgresql://fav:trocar_esta_senha@db:5432/favorabilidade

# Área de estudo (bbox WGS84: lon_min,lat_min,lon_max,lat_max) e EPSG de trabalho
AOI_BBOX=-48.5,-23.5,-46.0,-21.5
EPSG_TRABALHO=31983          # SIRGAS 2000 / UTM 23S — ajustar por projeto

# Resolução do grid (m) e do voxel 3D (dx, dy, dz em m)
GRID_RES=60
VOXEL_DX=100
VOXEL_DY=100
VOXEL_DZ=5
